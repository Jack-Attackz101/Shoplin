let activeCat='All', advOpen=false, firstLoad=false;

function starStr(n){return'★'.repeat(Math.floor(n))+(n%1>=.5?'½':'')+'☆'.repeat(5-Math.ceil(n));}

function renderGrid(prods){
  const grid=document.getElementById('pGrid');
  const empty=document.getElementById('emptyEl');
  const cnt=document.getElementById('resCnt');
  // exclude explore from count
  const realCount=prods.filter(p=>!p.isExplore).length;
  cnt.textContent=realCount+' product'+(realCount!==1?'s':'');
  if(!realCount){grid.innerHTML='';empty.classList.add('on');return;}
  empty.classList.remove('on');
  grid.innerHTML=prods.map((p,i)=>{
    if(p.isExplore) return`<div class="pc explore" style="animation-delay:${i*.05}s">
      <div class="pc-img"><img src="${p.img}" alt="More on Amazon" loading="lazy"/>
        <div class="pc-badge" style="background:var(--orange)">Amazon</div></div>
      <div class="pc-body">
        <div class="pc-cat" style="color:var(--orange)">Explore More</div>
        <div class="pc-name">${p.name}</div>
        <div class="pc-desc">${p.desc}</div>
        <div class="pc-foot">
          <span style="font-size:12px;color:var(--muted)">Thousands of results</span>
          <a href="${p.link}" target="_blank" class="pc-buy" style="background:var(--orange)">View on Amazon →</a>
        </div>
      </div></div>`;
    return`<div class="pc" style="animation-delay:${i*.05}s">
      <div class="pc-img">
        <img src="${p.img}" alt="${p.name}" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&q=80'"/>
        ${p.badge?`<div class="pc-badge">${p.badge}</div>`:''}
      </div>
      <div class="pc-body">
        <div class="pc-cat">${p.cat}</div>
        <div class="pc-name">${p.name}</div>
        <div class="pc-stars">${starStr(p.rat)} <span style="color:var(--muted);font-size:11px">(${p.rev.toLocaleString()})</span></div>
        <div class="pc-desc">${p.desc}</div>
        <div class="pc-foot">
          <div><span class="pc-price">$${p.price}</span>${p.old?`<span class="pc-old">$${p.old}</span>`:''}</div>
          <a href="${amz(p.q)}" target="_blank" class="pc-buy">Buy →</a>
        </div>
      </div></div>`;
  }).join('');
  bindCursor();
}

function showFeatured(){
  document.getElementById('resWrap').style.display='block';
  document.getElementById('resTtl').textContent='Featured Products';
  renderGrid(PRODS.slice(0,12));
}

function doSearch(){
  const q=document.getElementById('sInput').value.trim();
  const qL=q.toLowerCase();
  const minP=parseFloat(document.getElementById('minP').value)||0;
  const maxP=parseFloat(document.getElementById('maxP').value)||9999;
  const sort=document.getElementById('sortSel').value;
  const minRat=parseFloat(document.getElementById('advRat').value)||0;
  const onSale=document.getElementById('advAvail').value==='sale';
  const feats=[...document.querySelectorAll('.fcb:checked')].map(c=>c.value);

  const box=document.getElementById('aiBox'),txt=document.getElementById('aiTxt');
  box.classList.add('on');
  const msgs=['ShopLin AI is searching...','Analyzing your preferences...','Finding the best matches...','Almost there...'];
  let mi=0;
  const t=setInterval(()=>{mi=(mi+1)%msgs.length;txt.textContent=msgs[mi];},600);

  setTimeout(()=>{
    clearInterval(t); box.classList.remove('on');
    let res=PRODS.filter(p=>{
      const mC=activeCat==='All'||p.cat===activeCat;
      const mQ=!qL||p.name.toLowerCase().includes(qL)||p.cat.toLowerCase().includes(qL)||p.desc.toLowerCase().includes(qL);
      const mP=p.price>=minP&&p.price<=maxP;
      const mR=p.rat>=minRat;
      const mS=!onSale||(p.badge==='Sale');
      const mF=feats.every(f=>p.tags.includes(f));
      return mC&&mQ&&mP&&mR&&mS&&mF;
    });
    if(sort==='asc')res.sort((a,b)=>a.price-b.price);
    else if(sort==='desc')res.sort((a,b)=>b.price-a.price);
    else if(sort==='rat')res.sort((a,b)=>b.rat-a.rat);
    const explQ=q||(activeCat!=='All'?activeCat:'top products');
    res.push({isExplore:true,name:`Explore all "${explQ}" results`,
      desc:`Thousands more "${explQ}" results on Amazon, tagged with your ShopLin affiliate link.`,
      img:'https://images.unsplash.com/photo-1523474253046-8cd2748b5fd2?w=500&q=80',
      link:amz(explQ)});
    document.getElementById('resWrap').style.display='block';
    document.getElementById('resTtl').textContent=q?`Results for "${q}"`:activeCat!=='All'?activeCat:'All Products';
    renderGrid(res);
    document.getElementById('resWrap').scrollIntoView({behavior:'smooth',block:'start'});
  },1800);
}

function onKey(e){if(e.key==='Enter')doSearch();}
function setCat(el,cat){
  document.querySelectorAll('#catChips .chip').forEach(c=>c.classList.remove('on'));
  el.classList.add('on'); activeCat=cat;
}
function setPChip(el,mn,mx){
  document.querySelectorAll('.pchip').forEach(c=>c.classList.remove('on'));
  el.classList.add('on');
  document.getElementById('minP').value=mn;
  document.getElementById('maxP').value=mx;
}
function toggleAdv(){
  advOpen=!advOpen;
  document.getElementById('advPanel').classList.toggle('open',advOpen);
  document.getElementById('advBtnEl').textContent=advOpen?'✕ Close Advanced':'⚙️ Advanced Search';
}
function goShopCat(cat){
  activeCat=cat;
  goPage('shop');
  document.querySelectorAll('#catChips .chip').forEach(c=>{
    c.classList.toggle('on',c.textContent.trim().includes(cat));
  });
  setTimeout(doSearch,250);
}

// bestsellers
const bsPicks=PRODS.filter(p=>[3,6,10,16,18].includes(p.id));
document.getElementById('bsGrid').innerHTML=bsPicks.map(p=>`
  <a href="${amz(p.q)}" target="_blank" class="bs-card">
    <div class="bs-img"><img src="${p.img}" alt="${p.name}" loading="lazy" onerror="this.src='https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500&q=80'"/></div>
    <div class="bs-info">
      <div class="bs-name">${p.name}</div>
      <div class="bs-price">$${p.price}</div>
      <div class="bs-tag">Shop on Amazon →</div>
    </div>
  </a>`).join('');
</script>
